---
import { Building2, Stethoscope, Headset, CreditCard, BadgeDollarSign } from "lucide-react";
import BenefitCard from "./BenefitCard.astro";

const BENEFITS = [
  {
    icon: Building2,
    title: "Modern structure with cutting-edge technology.",
    description:
      "Planned environments and state-of-the-art equipment for greater comfort and precision.",
  },
  {
    icon: Stethoscope,
    title: "Experienced and specialized professionals",
    description: "A team committed to technical excellence and personalized service.",
  },
  {
    icon: Headset,
    title: "Welcoming and personalized service",
    description: "Here, each patient is unique and treated with empathy from beginning to end.",
  },
  {
    icon: CreditCard,
    title: "Easy payment plans",
    description: "Smiling well fits your budget: affordable and flexible payment options.",
  },
  {
    icon: BadgeDollarSign,
    title: "First consultation at a promotional price.",
    description: "Take the first step safely: initial assessment with a special price.",
  },
];
---

<section id="diferenciais" class="px-6 py-20 md:py-24">
  <div class="mx-auto max-w-[1200px]">
    <h2 class="text-center font-display text-[28px] font-bold text-cream sm:text-[34px]">
      Unique Features of the Clinic
    </h2>

    <div class="mx-auto mt-12 grid max-w-[820px] gap-5 sm:grid-cols-2">
      {BENEFITS.map((benefit) => <BenefitCard {...benefit} />)}
    </div>
  </div>
</section>
