---
import { MapPin, Phone, Mail } from "lucide-react";
import ToothIcon from "./ToothIcon";
import WhatsAppIcon from "./WhatsAppIcon";
---

<footer id="contato" class="bg-teal-950 px-6 py-14 text-cream">
  <div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-10 md:flex-row md:items-center">
    <div>
      <div class="flex items-center gap-2">
        <ToothIcon className="h-5 w-5" />
        <span class="font-display text-lg font-bold">Balaji Dental & Implant Center</span>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-cream/70">
        Taking care of your smile with health, aesthetics, and personalized service.
      </p>

      <ul class="mt-5 space-y-2 text-sm text-cream/70">
        <li class="flex items-center gap-2">
          <MapPin className="h-4 w-4 shrink-0" strokeWidth={1.8} />
          Resi Cum Clinic: Flat No 195, DDA SFS Flats, Pocket-1, Sector-9, Dwarka-110077
        </li>
        <li class="flex items-center gap-2">
          <Phone className="h-4 w-4 shrink-0" strokeWidth={1.8} />
          +91 81788 13235
        </li>
        <li class="flex items-center gap-2">
          <Mail className="h-4 w-4 shrink-0" strokeWidth={1.8} />
          balajidicentre@gmail.com
        </li>
      </ul>
    </div>

    <a
      href="https://wa.me/918178813235"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2.5 rounded-lg bg-cream px-6 py-3.5 text-sm font-semibold text-teal-900 shadow-md transition-transform hover:-translate-y-0.5 hover:bg-cream-soft"
    >
      <WhatsAppIcon className="h-4.5 w-4.5" />
      Schedule now on WhatsApp
    </a>
  </div>

  <div class="mx-auto mt-10 max-w-[1200px] border-t border-cream/10 pt-6 text-xs text-cream/50">
    © {new Date().getFullYear()} Balaji Dental & Implant Center. All rights reserved.
  </div>
</footer>
